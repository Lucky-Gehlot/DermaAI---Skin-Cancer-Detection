# GEMINI_API_KEY: Required for server-side Gemini AI educational calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC key used to sign HttpOnly session cookies.
# Generate a 32+ character random string in production.
SESSION_SECRET=""

# ADMIN_EMAIL: Optional comma-separated administrator email allowlist.
ADMIN_EMAIL=""

# DERMATOLOGY_MODEL_ENDPOINT: Optional HTTPS endpoint for a clinically validated external dermatology classifier.
# When unset or DERMATOLOGY_MODEL_VALIDATED is not "true", DermaAI runs safely in Demonstration Mode.
DERMATOLOGY_MODEL_ENDPOINT=""
DERMATOLOGY_MODEL_API_KEY=""
DERMATOLOGY_MODEL_VALIDATED="false"
DERMATOLOGY_MODEL_VERSION="derma-demo-0.1.0"
